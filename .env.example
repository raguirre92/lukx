# WordPress that feeds the blog and portfolio. Defaults to https://lukx.com.mx
WORDPRESS_URL=https://lukx.com.mx

# Optional: when set, POST /api/agendar forwards each booking here (Odoo, Make, n8n, etc.)
BOOKING_WEBHOOK_URL=https://tu-webhook.example.com/hooks/agendar
# Optional bearer token sent as Authorization: Bearer …
BOOKING_WEBHOOK_SECRET=
