# WordPress that feeds the blog and portfolio. Defaults to https://lukx.com.mx
WORDPRESS_URL=https://lukx.com.mx

# Odoo 18 Enterprise (server only). Set values in the host. Never commit secrets.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_UID=
ODOO_API_KEY=
ODOO_APPOINTMENT_TYPE_ID=
LEAD_SIGNING_SECRET=

# Local tests only. Do not set ODOO_MOCK on Vercel.
